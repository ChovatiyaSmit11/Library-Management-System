from passlib.context import CryptContext
import os
from datetime import datetime, timedelta
from typing import Union, Any
from jose import jwt, JWTError
import dotenv

dotenv.load_dotenv()

ACCESS_TOKEN_EXPIRE_MINUTES = int(os.getenv('ACCESS_TOKEN_EXPIRE_MINUTES') )
REFRESH_TOKEN_EXPIRE_MINUTES = int(os.getenv('REFRESH_TOKEN_EXPIRE_MINUTES')  )
ALGORITHM = os.getenv('ALGORITHM', 'HS256')
JWT_SECRET_KEY = os.getenv('JWT_SECRET_KEY')   
JWT_REFRESH_SECRET_KEY = os.getenv('JWT_REFRESH_SECRET_KEY')  

password_context = CryptContext(schemes=["bcrypt"], deprecated="auto")

# <-------------------------------------- Access Token --------------------------------------------->

def create_access_token(subject: Union[str, Any], email: str, expires_delta: int = None) -> str:
    if expires_delta is not None:
        expires_delta = datetime.utcnow() + expires_delta
    else:
        expires_delta = datetime.utcnow() + timedelta(minutes=ACCESS_TOKEN_EXPIRE_MINUTES)
    to_encode = {
        "exp": expires_delta,
        "sub": str(subject),
        "email": email,
        "exp_time": expires_delta.isoformat()  
    }
    encoded_jwt = jwt.encode(to_encode, JWT_SECRET_KEY, algorithm=ALGORITHM)
    return encoded_jwt


# <-------------------------------------- Refresh Token --------------------------------------------->

def create_refresh_token(subject: Union[str, Any], email: str, expires_delta: int = None) -> str:
    if expires_delta is not None:
        expires_delta = datetime.utcnow() + expires_delta
    else:
        expires_delta = datetime.utcnow() + timedelta(minutes=REFRESH_TOKEN_EXPIRE_MINUTES)
    to_encode = {
        "exp": expires_delta,
        "sub": str(subject),
        "email": email,
        "exp_time": expires_delta.isoformat()  
    }
    encoded_jwt = jwt.encode(to_encode, JWT_REFRESH_SECRET_KEY, algorithm=ALGORITHM)
    return encoded_jwt


# <-------------------------------------- Decode Token --------------------------------------------->

def decode_token(token: str, is_refresh_token: bool = False) -> dict:
    try:
        secret_key = JWT_REFRESH_SECRET_KEY if is_refresh_token else JWT_SECRET_KEY
        decoded_token = jwt.decode(token, secret_key, algorithms=[ALGORITHM])  
        email = decoded_token.get("email")
        exp_time = decoded_token.get("exp_time")  # This is in ISO format
        if not email or not exp_time:
            raise JWTError("Invalid token payload.")  
        return {
            "email": email,
            "exp_time": exp_time
        }
    except JWTError:
        raise JWTError("Token is invalid or expired.")


# <-------------------------------------- Is Token Valid --------------------------------------------->

def is_token_valid(token: str) -> bool:
    try:
        decode_token(token)
        return True
    except JWTError:
        return False
